[Unit]
Description=Studio workstation RES 2026.06 GPU/DCV runtime initialization
Documentation=https://github.com/vision-kwest/studio-workstation/issues/60
Wants=network-online.target
After=network-online.target display-manager.service
ConditionPathExists=/etc/dcv/dcv.conf

[Service]
Type=oneshot
User=root
Environment=RES_BASE_OS=ubuntu2404
Environment=MACHINE=x86_64
Environment=INSTANCE_FAMILY=g4dn
Environment=SESSION_TYPE=CONSOLE
Environment=IDEA_SESSION_OWNER=workstation
Environment=IDEA_SESSION_ID=studio-local-console
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/studio/runtime/studio_res_runtime.py
TimeoutStartSec=900
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
