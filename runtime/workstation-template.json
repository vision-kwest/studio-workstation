{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CPU RES 2026.06 derived runtime original workstation user-data",
  "Parameters": {
    "ImageId": {
      "Type": "AWS::EC2::Image::Id"
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "ClientCidr": {
      "Type": "String",
      "Default": "127.0.0.1/32",
      "AllowedPattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])$",
      "Description": "Explicit trusted client IPv4 /32; default loopback is intentionally unusable"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "m7i.large",
      "AllowedValues": [
        "m7i.large",
        "m7i.xlarge"
      ]
    },
    "DiskSizeGiB": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 60,
      "MaxValue": 2048
    },
    "InstanceProfileName": {
      "Type": "String",
      "Default": "StudioWorkstationSSMRole",
      "AllowedPattern": "[A-Za-z0-9+=,.@_-]+",
      "Description": "Existing EC2 instance profile with SSM and release archive read access"
    }
  },
  "Resources": {
    "WorkstationSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "DCV TCP 8443 from configurable IPv4 CIDR (public by default); no inbound SSH",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8443,
            "ToPort": 8443,
            "CidrIp": {
              "Ref": "ClientCidr"
            }
          }
        ]
      }
    },
    "Workstation": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "ImageId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "SubnetId": {
          "Ref": "SubnetId"
        },
        "SecurityGroupIds": [
          {
            "Ref": "WorkstationSG"
          }
        ],
        "IamInstanceProfile": {
          "Ref": "InstanceProfileName"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 2
        },
        "UserData": "RENDER_OFFLINE",
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": {
                "Ref": "DiskSizeGiB"
              },
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "studio-workstation-res-cpu"
          }
        ],
        "InstanceInitiatedShutdownBehavior": "terminate"
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Workstation"
      }
    }
  }
}
