#!/usr/bin/env python3
"""Studio Workstation CLI entry point: python3 studio workstation ..."""
import sys
from scripts.studio_workstation_cli import main

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] != "workstation":
        raise SystemExit("Usage: python3 studio workstation {create,status,start,stop,connect,destroy} [options]")
    main(sys.argv[2:])
