#!/usr/bin/env python3
"""Studio entry point: python3 studio env | workstation ..."""
import os
from pathlib import Path
import sys

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "env":
        shell = Path(__file__).resolve().parent / "scripts/studio-shell/studio"
        os.execv("/bin/bash", ["bash", str(shell), *sys.argv[1:]])
    if len(sys.argv) < 2 or sys.argv[1] != "workstation":
        raise SystemExit("Usage: python3 studio env | workstation {profiles,profile,create,list,status,start,stop,connect,hostname,destroy,run,result} [options]")
    from scripts.studio_workstation_cli import main
    main(sys.argv[2:])
