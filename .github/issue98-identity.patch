diff --git a/docs/studio-cli.md b/docs/studio-cli.md
index ac71a52..a38eebc 100644
--- a/docs/studio-cli.md
+++ b/docs/studio-cli.md
@@ -271,3 +271,29 @@ This read-only increment does not yet change create/start's legacy automatic GPU
 handoff, implement automatic recovery of a former owner's public address, or
 remove the single-GPU IAM/ACM restriction. Those remain #98 acceptance gates;
 these PRs must not be represented as completed multi-GPU hostname orchestration.
+
+### Per-workstation expiration identity (Issue #98, third increment)
+
+`infra/workstation-expiration-role.json` is an internal CloudFormation component,
+**not yet integrated into `create`**. The CLI's legacy GPU stack/token restriction
+remains in force; this increment does not enable concurrent GPU launches.
+
+A small independent safety stack owns one IAM role and its inline policy. Native
+CloudFormation creates and deletes both; there is no new custom cleanup service.
+The role name is generated by CloudFormation. The internal cleanup token is the
+unique UUID component of that safety stack's ARN, not a user-supplied parameter.
+Reusing a workstation name with a newly created safety stack produces a new token.
+Outputs provide `ExpirationRoleArn`, `CleanupToken`, and `WorkstationStack`.
+
+The Scheduler trust is restricted to this account and the existing schedule group.
+The two permissions remain termination of instances and deletion of volumes with
+**both** the exact workstation-name tag and this deployment's cleanup-token tag.
+The existing strict `pr65_gpu_create.preflight` accepts an explicit `role_arn` for
+verification; omitted values preserve the existing legacy role and launch path.
+
+Before connecting this component to billable creation, wire its outputs through
+all create/restart/extension/destroy checks and both schedules, and generalize ACM
+and explicit hostname ownership. The independent safety stack must outlive any
+active expiration schedules and cleanup failures. Do not delete its role while
+those safeguards are still needed. Shared EIP, DNS, ACM, EFS and existing roles
+are neither managed nor changed by this template. Live evidence belongs in the PR.
diff --git a/infra/workstation-expiration-role.json b/infra/workstation-expiration-role.json
new file mode 100644
index 0000000..fbdf5ec
--- /dev/null
+++ b/infra/workstation-expiration-role.json
@@ -0,0 +1,62 @@
+{
+  "AWSTemplateFormatVersion": "2010-09-09",
+  "Description": "Independent per-workstation expiration identity; no EC2, schedules or shared-resource changes.",
+  "Parameters": {
+    "WorkstationStack": {
+      "Type": "String",
+      "AllowedPattern": "[a-zA-Z][a-zA-Z0-9-]{0,127}"
+    },
+    "ScheduleGroup": {
+      "Type": "String",
+      "Default": "studio-task7-pr61",
+      "AllowedPattern": "[a-zA-Z0-9_.-]{1,64}"
+    }
+  },
+  "Resources": {
+    "ExpirationRole": {
+      "Type": "AWS::IAM::Role",
+      "Properties": {
+        "AssumeRolePolicyDocument": {
+          "Version": "2012-10-17",
+          "Statement": [{
+            "Effect": "Allow",
+            "Principal": {"Service": "scheduler.amazonaws.com"},
+            "Action": "sts:AssumeRole",
+            "Condition": {
+              "StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}},
+              "ArnEquals": {"aws:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:scheduler:${AWS::Region}:${AWS::AccountId}:schedule-group/${ScheduleGroup}"}}
+            }
+          }]
+        },
+        "Policies": [{
+          "PolicyName": "StudioPr65ExactTaggedExpiry",
+          "PolicyDocument": {
+            "Version": "2012-10-17",
+            "Statement": [{
+              "Effect": "Allow",
+              "Action": "ec2:TerminateInstances",
+              "Resource": {"Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*"},
+              "Condition": {"StringEquals": {
+                "ec2:ResourceTag/StudioStack": {"Ref": "WorkstationStack"},
+                "ec2:ResourceTag/StudioCleanupToken": {"Fn::Select": [2, {"Fn::Split": ["/", {"Ref": "AWS::StackId"}]}]}
+              }}
+            }, {
+              "Effect": "Allow",
+              "Action": "ec2:DeleteVolume",
+              "Resource": {"Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:volume/*"},
+              "Condition": {"StringEquals": {
+                "ec2:ResourceTag/StudioStack": {"Ref": "WorkstationStack"},
+                "ec2:ResourceTag/StudioCleanupToken": {"Fn::Select": [2, {"Fn::Split": ["/", {"Ref": "AWS::StackId"}]}]}
+              }}
+            }]
+          }
+        }]
+      }
+    }
+  },
+  "Outputs": {
+    "ExpirationRoleArn": {"Value": {"Fn::GetAtt": ["ExpirationRole", "Arn"]}},
+    "CleanupToken": {"Value": {"Fn::Select": [2, {"Fn::Split": ["/", {"Ref": "AWS::StackId"}]}]}},
+    "WorkstationStack": {"Value": {"Ref": "WorkstationStack"}}
+  }
+}
