#!/usr/bin/python3
"""Register shared Unity tools/projects, prepare preferences, and launch Hub or Editor."""
import base64
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET

apps = Path("/studio/apps")
hub = apps / "unity-hub/current/UnityHub.AppImage"
cli = apps / "unity-cli/current/unity"
editor = apps / "unity/current/Editor"
code = apps / "vscode/current/bin/code"
dotnet = apps / "dotnet"
android = editor / "Data/PlaybackEngines/AndroidPlayer"
shared_extensions = apps / "vscode/extensions"
for executable in (hub, cli, editor / "Unity", code, dotnet / "dotnet",
                   android / "SDK/platform-tools/adb", android / "NDK/ndk-build",
                   android / "OpenJDK/bin/java"):
    if not executable.is_file() or not os.access(executable, os.X_OK):
        sys.exit(f"UNITY: shared executable is unavailable: {executable}")
if not shared_extensions.is_dir() or not any(p.is_dir() for p in (dotnet / "sdk").glob("10.*")):
    sys.exit("UNITY: the shared VS Code extensions and .NET 10 SDK must be installed first.")
if not any(p.is_file() for p in (android / "Tools/gradle/lib").glob("gradle-launcher-*.jar")):
    sys.exit("UNITY: the Editor's bundled Gradle launcher is unavailable.")

extensions = Path.home() / ".vscode/extensions"
if extensions.exists() or extensions.is_symlink():
    if not extensions.exists() or not extensions.samefile(shared_extensions):
        sys.exit(f"UNITY: preserve and move the conflicting path before retrying: {extensions}")
prefs = Path.home() / ".local/share/unity3d/prefs"
if prefs.is_symlink():
    sys.exit(f"UNITY: resolve the existing preferences symlink before retrying: {prefs}")
try:
    tree = ET.parse(prefs, parser=ET.XMLParser(target=ET.TreeBuilder(insert_comments=True))) if prefs.exists() else ET.ElementTree(
        ET.Element("unity_prefs", version_major="1", version_minor="1"))
except (ET.ParseError, OSError) as error:
    sys.exit(f"UNITY: cannot read existing preferences; left unchanged: {error}")
root = tree.getroot()
if root.tag != "unity_prefs" or root.attrib != {"version_major": "1", "version_minor": "1"}:
    sys.exit(f"UNITY: unrecognized preferences format; left unchanged: {prefs}")
seed_editor = root.find("pref[@name='kScriptsDefaultApp']") is None
if seed_editor and subprocess.run(
        ["pgrep", "-u", str(os.getuid()), "-x", "Unity"], stdout=subprocess.DEVNULL).returncode == 0:
    sys.exit("UNITY: close the Unity Editor once before initializing its missing editor preference.")

extensions.parent.mkdir(parents=True, exist_ok=True)
if not extensions.exists():
    extensions.symlink_to(shared_extensions)
if seed_editor:
    ET.SubElement(root, "pref", name="kScriptsDefaultApp", type="string").text = base64.b64encode(str(code).encode()).decode()
    prefs.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=prefs.parent, prefix=".prefs-", delete=False) as temporary:
        temporary_path = Path(temporary.name)
        try:
            tree.write(temporary, encoding="utf-8", xml_declaration=True)
            temporary.flush()
            os.replace(temporary_path, prefs)
        finally:
            temporary_path.unlink(missing_ok=True)

os.environ["DOTNET_ROOT"] = str(dotnet)
os.environ["PATH"] = str(dotnet) + os.pathsep + os.environ.get("PATH", "/usr/bin:/bin")
projects = sorted({str(p.parent.parent) for p in Path("/studio/projects/unity").glob(
    "*/ProjectSettings/ProjectVersion.txt") if p.is_file()})
for path in projects:
    project = Path(path).resolve()
    library = project / "Library"
    key = hashlib.sha256(str(project).encode()).hexdigest()[:16]
    cache = Path.home() / ".cache/studio-unity" / key / "Library"
    if library.is_symlink():
        if library.resolve() != cache.resolve():
            sys.exit(f"UNITY: preserve the different Library link before retrying: {library}")
        cache.mkdir(parents=True, exist_ok=True)
        continue
    if (project / "Temp/UnityLockfile").exists() or subprocess.run(
            ["pgrep", "-u", str(os.getuid()), "-x", "Unity"], stdout=subprocess.DEVNULL).returncode != 1:
        sys.exit(f"UNITY: save and close all Unity Editors before preparing the local Library: {project}")
    backup = project / "Library.efs-backup"
    if library.exists() and (not library.is_dir() or os.path.lexists(backup)):
        sys.exit(f"UNITY: preserve the existing Library/backup before retrying: {project}")
    cache.mkdir(parents=True, exist_ok=True)
    moved = library.exists()
    if moved:
        library.rename(backup)
    try:
        library.symlink_to(cache, target_is_directory=True)
    except OSError:
        if moved and not os.path.lexists(library):
            backup.rename(library)
        raise
if projects:
    result = subprocess.run([str(cli), "--non-interactive", "--format", "json", "projects"],
                            capture_output=True, text=True)
    try:
        report = json.loads(result.stdout)
        if result.returncode or report["success"] is not True or report["data"].get("partial") or report["data"].get("nextPage"):
            raise ValueError("incomplete project listing")
        registered = {Path(p["path"]).resolve() for p in report["data"]["items"]}
    except (ValueError, KeyError, TypeError, AttributeError) as error:
        sys.exit(f"UNITY: cannot read the native project list ({error}):\n{result.stderr}{result.stdout}")
    projects = [p for p in projects if Path(p).resolve() not in registered]
for kind, paths in (("editors", [str((editor / "Unity").resolve())]), ("projects", projects)):
    if not paths:
        continue
    result = subprocess.run([str(cli), "--non-interactive", "--format", "json", kind, "add", *paths],
                            capture_output=True, text=True)
    if result.returncode:
        try:
            errors = json.loads(result.stdout).get("errors", [])
        except (json.JSONDecodeError, AttributeError):
            errors = []
        if kind == "editors" and result.returncode == 6 and isinstance(errors, list) and errors and all(
                isinstance(e, dict) and e.get("code") == "EDITORS_ADD_ALREADY_IN_LIST" for e in errors):
            continue
        sys.exit(f"UNITY: native {kind} registration failed:\n{result.stderr}{result.stdout}")
arguments = sys.argv[1:]
application = hub
if arguments[:1] == ["--editor"]:
    application, arguments = editor / "Unity", arguments[1:]
os.execv(application, [str(application), *arguments])
