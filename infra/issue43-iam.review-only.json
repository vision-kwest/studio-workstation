{
  "Description": "Review-only policy sketches. NOT DEPLOYED. Separate Lambda and EC2 roles; no credentials, no policy updates.",
  "HostedZoneId": "Z02607163QPWX22FZ2Q9M",
  "LambdaDnsPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ReadPinnedInstance",
        "Effect": "Allow",
        "Action": [
          "ec2:DescribeInstances"
        ],
        "Resource": "*"
      },
      {
        "Sid": "ReadDnsRecord",
        "Effect": "Allow",
        "Action": [
          "route53:ListResourceRecordSets"
        ],
        "Resource": "arn:aws:route53:::hostedzone/Z02607163QPWX22FZ2Q9M"
      },
      {
        "Sid": "UpdateOnlyDcvARecord",
        "Effect": "Allow",
        "Action": [
          "route53:ChangeResourceRecordSets"
        ],
        "Resource": "arn:aws:route53:::hostedzone/Z02607163QPWX22FZ2Q9M",
        "Condition": {
          "ForAllValues:StringEquals": {
            "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
              "dcv.kwesidavis.com"
            ],
            "route53:ChangeResourceRecordSetsRecordTypes": [
              "A"
            ],
            "route53:ChangeResourceRecordSetsActions": [
              "UPSERT",
              "DELETE"
            ]
          }
        }
      }
    ]
  },
  "WorkstationCertbotPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "CertbotDiscoverZones",
        "Effect": "Allow",
        "Action": [
          "route53:ListHostedZones"
        ],
        "Resource": "*"
      },
      {
        "Sid": "CertbotWaitForChange",
        "Effect": "Allow",
        "Action": [
          "route53:GetChange"
        ],
        "Resource": "arn:aws:route53:::change/*"
      },
      {
        "Sid": "CertbotOnlyChallengeTxt",
        "Effect": "Allow",
        "Action": [
          "route53:ChangeResourceRecordSets"
        ],
        "Resource": "arn:aws:route53:::hostedzone/Z02607163QPWX22FZ2Q9M",
        "Condition": {
          "ForAllValues:StringEquals": {
            "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
              "_acme-challenge.dcv.kwesidavis.com"
            ],
            "route53:ChangeResourceRecordSetsRecordTypes": [
              "TXT"
            ],
            "route53:ChangeResourceRecordSetsActions": [
              "UPSERT",
              "DELETE",
              "CREATE"
            ]
          }
        }
      }
    ]
  }
}
