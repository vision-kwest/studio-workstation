{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "INDEPENDENT test-only deadline cleanup; deploy in a separate stack BEFORE GPU CLI creation.",
  "Parameters": {
    "TestStack": {"Type": "String", "AllowedPattern": "^studio-gpu-cli-[a-z0-9-]{1,110}$"},
    "CleanupToken": {"Type": "String", "NoEcho": true, "MinLength": 12, "MaxLength": 64, "AllowedPattern": "^[a-z0-9-]+$"},
    "DeadlineUtc": {"Type": "String", "AllowedPattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "LambdaZipBucket": {"Type": "String"},
    "LambdaZipKey": {"Type": "String"},
    "LambdaZipVersion": {"Type": "String"},
    "AlarmEmail": {"Type": "String", "AllowedPattern": "^[^@ ]+@[^@ ]+\\.[^@ ]+$"}
  },
  "Resources": {
    "AlarmTopic": {"Type": "AWS::SNS::Topic"},
    "AlarmSubscription": {"Type": "AWS::SNS::Subscription", "Properties": {"TopicArn": {"Ref": "AlarmTopic"}, "Protocol": "email", "Endpoint": {"Ref": "AlarmEmail"}}},
    "CleanupRole": {"Type": "AWS::IAM::Role", "Properties": {
      "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
      "Policies": [{"PolicyName": "OneTestOnly", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
        {"Sid": "ReadInventory", "Effect": "Allow", "Action": ["cloudformation:DescribeStacks", "ec2:DescribeInstances", "ec2:DescribeVolumes", "ec2:DescribeSecurityGroups", "ec2:DescribeLaunchTemplates"], "Resource": "*"},
        {"Sid": "DeleteOnlyNamedStack", "Effect": "Allow", "Action": "cloudformation:DeleteStack", "Resource": {"Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${TestStack}/*"}},
        {"Sid": "TerminateOwnedInstance", "Effect": "Allow", "Action": "ec2:TerminateInstances", "Resource": {"Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*"}, "Condition": {"StringEquals": {"ec2:ResourceTag/StudioCleanupToken": {"Ref": "CleanupToken"}, "ec2:ResourceTag/StudioStack": {"Ref": "TestStack"}}}},
        {"Sid": "DeleteOwnedVolume", "Effect": "Allow", "Action": "ec2:DeleteVolume", "Resource": {"Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:volume/*"}, "Condition": {"StringEquals": {"ec2:ResourceTag/StudioCleanupToken": {"Ref": "CleanupToken"}, "ec2:ResourceTag/StudioStack": {"Ref": "TestStack"}}}},
        {"Sid": "DeleteOwnedSecurityGroup", "Effect": "Allow", "Action": "ec2:DeleteSecurityGroup", "Resource": {"Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:security-group/*"}, "Condition": {"StringEquals": {"ec2:ResourceTag/StudioCleanupToken": {"Ref": "CleanupToken"}, "ec2:ResourceTag/StudioStack": {"Ref": "TestStack"}}}},
        {"Sid": "DeleteOwnedLaunchTemplate", "Effect": "Allow", "Action": "ec2:DeleteLaunchTemplate", "Resource": {"Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:launch-template/*"}, "Condition": {"StringEquals": {"ec2:ResourceTag/StudioCleanupToken": {"Ref": "CleanupToken"}, "ec2:ResourceTag/StudioStack": {"Ref": "TestStack"}}}},
        {"Sid": "OwnLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${CleanupFunction}:*"}}
      ]}}]
    }},
    "CleanupFunction": {"Type": "AWS::Lambda::Function", "Properties": {
      "FunctionName": {"Fn::Sub": "studio-gpu-cli-cleanup-\${TestStack}"}, "Runtime": "python3.12", "Handler": "gpu_cli_test_cleanup.handler", "Timeout": 120,
      "Role": {"Fn::GetAtt": ["CleanupRole", "Arn"]},
      "Code": {"S3Bucket": {"Ref": "LambdaZipBucket"}, "S3Key": {"Ref": "LambdaZipKey"}, "S3ObjectVersion": {"Ref": "LambdaZipVersion"}},
      "Environment": {"Variables": {"STUDIO_TEST_STACK": {"Ref": "TestStack"}, "STUDIO_CLEANUP_TOKEN": {"Ref": "CleanupToken"}, "STUDIO_NOT_BEFORE_UTC": {"Ref": "DeadlineUtc"}, "STUDIO_FAIL_PENDING": "true"}}
    }},
    "CleanupLogGroup": {"Type": "AWS::Logs::LogGroup", "Properties": {"LogGroupName": {"Fn::Sub": "/aws/lambda/${CleanupFunction}"}, "RetentionInDays": 30}},
    "ScheduleRole": {"Type": "AWS::IAM::Role", "Properties": {
      "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "scheduler.amazonaws.com"}, "Action": "sts:AssumeRole", "Condition": {"StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}}}}]},
      "Policies": [{"PolicyName": "InvokeOneCleanupLambda", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": "lambda:InvokeFunction", "Resource": {"Fn::GetAtt": ["CleanupFunction", "Arn"]}}]}}]
    }},
    "CleanupSchedule": {"Type": "AWS::Scheduler::Schedule", "Properties": {
      "ScheduleExpression": "rate(5 minutes)", "FlexibleTimeWindow": {"Mode": "OFF"},
      "State": "ENABLED", "Target": {"Arn": {"Fn::GetAtt": ["CleanupFunction", "Arn"]}, "RoleArn": {"Fn::GetAtt": ["ScheduleRole", "Arn"]}, "RetryPolicy": {"MaximumRetryAttempts": 2, "MaximumEventAgeInSeconds": 600}}
    }},
    "ErrorAlarm": {"Type": "AWS::CloudWatch::Alarm", "Properties": {
      "AlarmDescription": "Deadline cleanup pending/failing; investigate until verified absent",
      "Namespace": "AWS/Lambda", "MetricName": "Errors", "Dimensions": [{"Name": "FunctionName", "Value": {"Ref": "CleanupFunction"}}],
      "Statistic": "Sum", "Period": 300, "EvaluationPeriods": 1, "Threshold": 0,
      "ComparisonOperator": "GreaterThanThreshold", "TreatMissingData": "breaching",
      "AlarmActions": [{"Ref": "AlarmTopic"}]
    }}
  },
  "Outputs": {"CleanupLambdaArn": {"Value": {"Fn::GetAtt": ["CleanupFunction", "Arn"]}}, "CleanupScheduleArn": {"Value": {"Fn::GetAtt": ["CleanupSchedule", "Arn"]}}, "AlarmTopicArn": {"Value": {"Ref": "AlarmTopic"}}}
}
