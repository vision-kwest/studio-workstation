{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyResNvidiaGridLatest",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ec2-linux-nvidia-drivers",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "latest/",
            "latest/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyResNvidiaGrid5959107",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::ec2-linux-nvidia-drivers/latest/NVIDIA-Linux-x86_64-595.91.07-grid-aws.run"
    }
  ]
}
